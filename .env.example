# ============================================================
# Discord Bot Configuration
# ============================================================

# Discord Bot Token (from Discord Developer Portal)
# Create at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Channel ID for notifications (right-click channel -> Copy ID)
DISCORD_CHANNEL_ID=123456789012345678

# Admin user IDs (comma-separated, can use /schedule, /cleanup, etc.)
ADMIN_USER_IDS=123456789012345678

# ============================================================
# Legacy Webhook Configuration (still works for CLI mode)
# ============================================================

# Discord webhook URL for notifications (optional if using bot)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ============================================================
# General Configuration
# ============================================================

# Optional HTTP proxy
PROXY_URL=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Database path (default: ./data/listings.db)
DB_PATH=./data/listings.db
