[Unit]
Description=Wheel Scraper Discord Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/yajscraper
ExecStart=/home/ubuntu/yajscraper/venv/bin/python bot.py
Restart=always
RestartSec=10

# Environment
Environment=PYTHONUNBUFFERED=1

# Logging: bot.py writes logs/bot.log itself; stdout/stderr go to the
# journal (sudo journalctl -u wheelbot) so lines are not written twice

[Install]
WantedBy=multi-user.target
